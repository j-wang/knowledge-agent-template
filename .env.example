# ===========================================================================
# Knowledge Agent — retrieval configuration (ALL OPTIONAL)
# ===========================================================================
# Copy to `.env` and uncomment the block you want:
#     cp .env.example .env
#
# ZERO CONFIG (this file empty / not copied) = local BM25 only, no network,
# no extra dependencies. Everything below is opt-in. Any misconfiguration or
# unreachable server degrades gracefully back to BM25 with a one-line warning.
#
# Use placeholder hosts/keys only — replace with your own.
# ===========================================================================


# ---------------------------------------------------------------------------
# EMBEDDINGS — true query->doc dense retrieval (RRF-fused with BM25)
# ---------------------------------------------------------------------------
# KB_EMBED_PROVIDER : none (default) | openai | tei | sentence-transformers
# KB_EMBED_MODEL    : provider-specific model id
# KB_EMBED_ENDPOINT : base URL for an openai-compatible or TEI HTTP server
# KB_EMBED_API_KEY  : api key; falls back to OPENAI_KEY / OPENAI_API_KEY
# KB_EMBED_TIMEOUT  : per-request timeout, seconds (default 10)
# KB_EMBED_WAKE_CMD : optional shell command run if the endpoint is unreachable
#                     (e.g. a self-hosted GPU box that auto-suspends). We run it,
#                     poll the endpoint until it answers, then retry. See the
#                     "WAKING A SLEEPING SELF-HOSTED BOX" block below.
# KB_EMBED_WAKE_TIMEOUT : seconds to wait after waking (default 120)
#
# After setting an embed provider, run `uv run build_embeddings.py` to embed
# the corpus, then `python3 search.py --rebuild --bm25-only`.

# --- (a) OpenAI embeddings (or any OpenAI-compatible /v1/embeddings server) ---
# KB_EMBED_PROVIDER=openai
# KB_EMBED_MODEL=text-embedding-3-small
# KB_EMBED_API_KEY=sk-REPLACE_ME
# # Optional: point at a self-hosted OpenAI-compatible server instead of OpenAI:
# # KB_EMBED_ENDPOINT=http://YOUR-LLM-HOST:8000

# --- (b) Generic TEI (HuggingFace text-embeddings-inference) endpoint ---
# KB_EMBED_PROVIDER=tei
# KB_EMBED_ENDPOINT=http://YOUR-GPU-HOST:8080
# # KB_EMBED_API_KEY=optional-if-your-tei-is-gated

# --- (c) Local sentence-transformers (optional dependency) ---
# # Requires: pip install sentence-transformers
# KB_EMBED_PROVIDER=sentence-transformers
# KB_EMBED_MODEL=BAAI/bge-small-en-v1.5


# ---------------------------------------------------------------------------
# RERANKING — precision pass over the top-N fused candidates
# ---------------------------------------------------------------------------
# KB_RERANK_PROVIDER : none (default) | tei | cohere | http
# KB_RERANK_MODEL    : provider-specific model id
# KB_RERANK_ENDPOINT : base URL for the rerank server
# KB_RERANK_API_KEY  : api key (if the provider needs one)
# KB_RERANK_TIMEOUT  : per-request timeout, seconds (default 10)
# KB_RERANK_TOP_N    : how many fused candidates to rerank (default 50)
# KB_RERANK_WAKE_CMD : optional wake command if the rerank endpoint is unreachable
# KB_RERANK_WAKE_TIMEOUT : seconds to wait after waking (default 120)

# --- (d) Cohere reranker ---
# KB_RERANK_PROVIDER=cohere
# KB_RERANK_MODEL=rerank-english-v3.0
# KB_RERANK_API_KEY=REPLACE_ME

# --- (e) TEI reranker (HuggingFace text-embeddings-inference, rerank mode) ---
# KB_RERANK_PROVIDER=tei
# KB_RERANK_ENDPOINT=http://YOUR-GPU-HOST:8081

# --- generic HTTP reranker -------------------------------------------------
# # POST {endpoint} body {"query": str, "documents": [str,...]}
# # -> a bare list of floats (one score per doc, in order) OR {"scores":[...]}
# KB_RERANK_PROVIDER=http
# KB_RERANK_ENDPOINT=http://YOUR-RERANK-HOST:9000/rerank
# # KB_RERANK_API_KEY=optional


# ---------------------------------------------------------------------------
# WAKING A SLEEPING SELF-HOSTED BOX (optional)
# ---------------------------------------------------------------------------
# If your embed/rerank server runs on a machine that auto-suspends to save
# power, give the retriever a command to wake it. When the endpoint is
# unreachable, the command runs once, then we poll the endpoint until it
# answers (up to *_WAKE_TIMEOUT) and retry. If it never comes up, retrieval
# degrades to BM25 as usual. The command is YOUR shell string and runs on the
# machine doing the search — keep this in your private (gitignored) .env.
#
# Wake-on-LAN a box by MAC (sender must be on the same L2 segment):
# KB_EMBED_WAKE_CMD=wakeonlan AA:BB:CC:DD:EE:FF
# KB_RERANK_WAKE_CMD=wakeonlan AA:BB:CC:DD:EE:FF
# KB_EMBED_WAKE_TIMEOUT=120
#
# Or wake via a jump host / start the service over SSH:
# KB_EMBED_WAKE_CMD=ssh my-gpu-box 'sudo systemctl start tei.service'
# # (from a host that can't broadcast WoL directly:)
# # KB_EMBED_WAKE_CMD=ssh my-lan-gateway 'wakeonlan AA:BB:CC:DD:EE:FF'


# ---------------------------------------------------------------------------
# RETRIEVAL MODE
# ---------------------------------------------------------------------------
# KB_RETRIEVAL_MODE : auto (default) | bm25 | dense | hybrid
#   auto   = hybrid (RRF of BM25 + dense) when doc embeddings are present AND an
#            embedder is available; otherwise bm25-only.
#   bm25   = BM25 only (ignore dense even if available)
#   dense  = dense only (falls back to BM25 if embeddings unavailable)
#   hybrid = always RRF-fuse BM25 + dense (falls back to BM25 if no dense)
# KB_RETRIEVAL_MODE=auto


# ---------------------------------------------------------------------------
# Back-compat: legacy embeddings key still honored as an OpenAI api-key source.
# ---------------------------------------------------------------------------
# OPENAI_KEY=sk-...
